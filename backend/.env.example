# GramSwasth Environment Configuration
# Copy to .env and fill in your values for deployment

# Flask
FLASK_ENV=production
DEBUG=False

# Database
# Development: sqlite:///telehealth.db
# Production: postgresql://user:password@host:5432/telehealth
DATABASE_URL=postgresql://postgres:postgres@db:5432/telehealth
DB_NAME=telehealth
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (Socket.IO scaling + caching)
REDIS_URL=redis://redis:6379/0

# Security (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# CORS
FLASK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Offline Sync Configuration
OFFLINE_CACHE_DIR=~/.telehealth_cache
MAX_SYNC_RETRY=3
SYNC_BATCH_SIZE=50

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
